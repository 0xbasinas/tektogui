{
  "version": 1,
  "description": "JSX components an agent can mount. Kinds match NodeKind and tekto-widgets. Each kind lists every prop the host setProp accepts, because JSX forwards that set on every kind. title, font_size, and justify_center are aliases (see propAliases). Button onClick, text_field onInput and text-node reactive text need a retained host. Desktop QuickJS and the WASM host support these callbacks.",
  "propAliases": {
    "title": "name",
    "font_size": "fontSize",
    "justify_center": "justifyCenter",
    "border_color": "borderColor",
    "border_width": "borderWidth"
  },
  "components": [
    {
      "name": "window",
      "description": "Root window. Defaults to page fill, padding, and gap, like tekto::window.",
      "props": [
        {"name": "testKey", "type": "string", "description": "Optional developer test key."},
        {"name": "checked", "type": "boolean"},
        {"name": "value", "type": "number"},
        {"name": "name", "type": "string", "description": "Accessible name. JSX title is an alias."},
        {"name": "title", "type": "string", "description": "Alias of name."},
        {"name": "text", "type": "string", "jsxType": "string | number"},
        {"name": "width", "type": "number"},
        {"name": "height", "type": "number"},
        {"name": "fill", "type": "string", "description": "#rrggbb or #rrggbbaa."},
        {"name": "color", "type": "string", "description": "#rrggbb or #rrggbbaa."},
        {"name": "fontSize", "type": "number"},
        {"name": "radius", "type": "number"},
        {"name": "borderColor", "type": "string"},
        {"name": "borderWidth", "type": "number"},
        {"name": "padding", "type": "number"},
        {"name": "gap", "type": "number"},
        {"name": "column", "type": "boolean"},
        {"name": "justifyCenter", "type": "boolean"}
      ],
      "events": [
        {"name": "click", "description": "ui.click sets focus and last_click. No onClick prop."}
      ],
      "jsxProps": [
        {"name": "contextMenu", "type": "object", "jsxType": "TektoElement", "description": "Detached menu opened by a context-menu gesture."}
      ]
    },
