{
  "name": "@tektogui/wasm",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Browser glue for the Tekto WASM core. Same HostOp JSON as desktop. App calls have no DOM types. Optional canvas blit lives in ./canvas.",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./canvas": {
      "types": "./src/canvas.d.ts",
      "import": "./src/canvas.js",
      "default": "./src/canvas.js"
    },
    "./gpu": {
      "types": "./src/gpu.d.ts",
      "import": "./src/gpu.js",
      "default": "./src/gpu.js"
    },
    "./patch": {
      "types": "./src/patch.d.ts",
      "import": "./src/patch.js",
      "default": "./src/patch.js"
    }
  },
  "files": [
    "src",
    "smoke.html",
    "notes.html",
    "gpu.html"
  ],
  "devDependencies": { "@tektogui/build": "file:../build" },
  "scripts": {
    "test": "node --test test.js"
  }
}
